@startuml
title AI Service API Request/Response Schema

' Request Schema
package "FeedbackRequest" as RequestPackage {
    class FeedbackRequest <<JSON>> {
        + quiz_id: string
        + question_id: string
        + student_id: string
        + student_answer: string
        + question_text: string
        + model_answer: string
        + key_concepts: string[]
        + context_info?: object
    }
}

' Response Schema
package "FeedbackResponse" as ResponsePackage {
    class FeedbackResponse <<JSON>> {
        + status: string
        + message: string
        + feedback?: FeedbackResponseData
    }

    class FeedbackResponseData <<JSON>> {
        + feedback_text: string
        + error_identified: boolean
        + error_type?: string[]
        + confidence_score?: float
        + concepts_covered?: string[]
        + concepts_missed?: string[]
        + recommended_resources?: RecommendedResource[]
    }

    class RecommendedResource <<JSON>> {
        + title: string
        + url: string
        + type: string
    }
}

' Relationships
FeedbackRequest --> FeedbackResponse : HTTP POST /feedback/generate
FeedbackResponse *-- FeedbackResponseData
FeedbackResponseData *-- RecommendedResource : 0..*

